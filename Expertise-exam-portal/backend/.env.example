# Copy this file to .env and adjust if needed.

PORT=5000

# Where your local Ollama server is running. Default is correct for a normal install.
OLLAMA_HOST=http://localhost:11434

# Any model you've pulled with `ollama pull <model>`.
# If question generation feels slow, this is the #1 lever to pull — try a
# smaller model first:
#   llama3.2:3b   fast, small, good enough for MCQ generation (recommended default)
#   phi3          fast, small
#   qwen2.5:3b    fast, small
#   llama3.1:8b   slower but higher quality, needs a decent GPU or patience on CPU
#   mistral       mid-size alternative
OLLAMA_MODEL=llama3.2:3b

# Maximum time for one small batch. The code requests at most 5 questions at once.
OLLAMA_TIMEOUT_MS=150000

# Allow the frontend dev server to call this API
CORS_ORIGIN=http://localhost:5173

# MySQL database used to persist generated exam questions.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=Madhan@23
DB_NAME=wehere
DB_CONNECT_TIMEOUT=5000
